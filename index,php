<?php
session_start();

require_once __DIR__ . '/controllers/AuthController.php';
require_once __DIR__ . '/controllers/LaundryController.php';

$action = $_GET['action'] ?? 'login';

$authController    = new AuthController();
$laundryController = new LaundryController();

switch ($action) {
    case 'login':
        $authController->login();
        break;
    case 'logout':
        $authController->logout();
        break;
    case 'dashboard':
        $laundryController->index();
        break;
    case 'create':
        $laundryController->create();
        break;
    case 'edit':
        $laundryController->edit();
        break;
    case 'update_status':
        $laundryController->updateStatus();
        break;
    case 'delete':
        $laundryController->delete();
        break;
    case 'track':
        $laundryController->track();
        break;
    default:
        $authController->login();
        break;
}